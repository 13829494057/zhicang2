# 复制为 .env 后填入真实值。本文件可以提交，.env 不可以。

# ── OAuth 应用凭证（赛事页面「创建项目」后分配）──
ZHIHU_APP_ID=
ZHIHU_APP_KEY=

# ── 开放平台 Access Secret（developer.zhihu.com/profile 自助申请）──
# 服务端用它调用户数据 API。所有访客共用这一个额度池（实测 1000 次/天），
# 额度算在这个开发者账号头上，与登录的访客无关。团队任一成员的 Secret 均可。
ZHIHU_ACCESS_SECRET=

# ── OAuth 回调地址，必须与赛事页面项目配置的登记值完全一致 ──
# 本地调试：http://127.0.0.1  （知乎对回环地址的支持有限，OAuth 建议在公网域名联调）
# 生产部署：https://你的域名/auth/zhihu/callback
ZHIHU_REDIRECT_URI=https://your-domain/auth/zhihu/callback

# 服务端口（AiWorks 等平台通常通过 PORT 注入）
PORT=3000

# 会话加密盐（任意随机字符串，生产环境务必更换）
SESSION_SECRET=change-this-to-a-random-string

# 本地 UI 预览开关：设为 1 时开放 /__dev/login（用 Access Secret 本人身份预览）
# 生产部署绝对不要设置该变量
# ALLOW_DEV_LOGIN=1

